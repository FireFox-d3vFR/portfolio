---
import { getImage } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import { webAnalyticsEnabled } from '../data/site';
import faviconTailDark from '../assets/brand/favicon-tail-dark.png';
import { SEASONS_BY_MONTH } from '../lib/seasons';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '../styles/portfolio.css';
import '@fontsource/manrope/latin-700.css';

const favicons = await Promise.all(
  [16, 32, 48].map((size) =>
    getImage({ src: faviconTailDark, width: size, height: size, format: 'png' }),
  ),
);

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  noindex = false,
  title = 'Jonathan Maquenhem — Développeur Full Stack',
  description = 'Développeur Full Stack, curieux des besoins métier, du DevOps et de l’intégration. Découvrez mon parcours et mes contributions.',
} = Astro.props;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const shareImage = Astro.site ? new URL('/partage.png', Astro.site) : undefined;
// Une prévisualisation ne doit pas concurrencer le site public dans les moteurs.
const preventIndexing = noindex || !Astro.site || import.meta.env.VERCEL_ENV === 'preview';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf2e6" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Jonathan Maquenhem" />
    {preventIndexing && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:width" content="1200" />}
    {shareImage && <meta property="og:image:height" content="630" />}
    {shareImage && (
      <meta
        property="og:image:alt"
        content="Jonathan Maquenhem, développeur Full Stack. Symfony, Vue.js, DevOps et Cloud."
      />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    {favicons.map((icon) => (
      <link
        rel="icon"
        type="image/png"
        sizes={icon.attributes.width + 'x' + icon.attributes.height}
        href={icon.src}
      />
    ))}
    <script is:inline define:vars={{ seasonMonths: SEASONS_BY_MONTH }}>
      // Appliquer la palette avant l’affichage, avec le calendrier partagé du contrôleur.
      let savedMode = null;
      let savedSeason = null;
      try {
        savedMode = localStorage.getItem('portfolio-season-mode');
        savedSeason = localStorage.getItem('portfolio-season');
      } catch {}
      const manual =
        ['printemps', 'ete', 'automne', 'hiver'].includes(savedSeason) &&
        (savedMode === 'manual' || savedMode === null);
      document.documentElement.dataset.season = manual
        ? savedSeason
        : seasonMonths[new Date().getMonth()];
      document.documentElement.dataset.seasonMode = manual ? 'manual' : 'auto';
      try {
        const appearance = localStorage.getItem('portfolio-appearance');
        if (appearance === 'dark' || appearance === 'light')
          document.documentElement.dataset.appearance = appearance;
      } catch {}
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <slot />
    {webAnalyticsEnabled && <Analytics mode="production" debug={false} />}
  </body>
</html>
