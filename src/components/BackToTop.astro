---
interface Props { href?: string; }
const { href = '#accueil' } = Astro.props;
---
<a href={href} data-back-to-top class="back-to-top" aria-label="Retour en haut de la page" title="Retour en haut" hidden>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6" /></svg>
</a>
