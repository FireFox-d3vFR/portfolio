---
import { Image } from 'astro:assets';
import head from '../../assets/brand/favicon-head-outline.png';
import tail from '../../assets/brand/favicon-tail-outline.png';
import active from '../../assets/brand/favicon-tail-dark.png';
const options = [
  {
    id: 'head',
    label: 'Tête au trait',
    description: 'Les oreilles et le museau, sans œil ni détail du pelage.',
    src: head,
  },
  {
    id: 'tail',
    label: 'Queue au trait',
    description:
      'Une queue courbée avec quelques pointes pour évoquer la fourrure, sans aplat coloré.',
    src: tail,
  },
];
const backgrounds = [
  { label: 'Orange', background: '#BA4A12', foreground: '#FFF9EE', darkLine: false },
  { label: 'Noir', background: '#171717', foreground: '#FFF9EE', darkLine: false },
  { label: 'Blanc', background: '#FFFFFF', foreground: '#171717', darkLine: true },
];
---

<section class="mt-12" aria-labelledby="favicon-explorations">
  <h2 id="favicon-explorations" class="text-2xl font-medium">
    Deux signes, trois fonds.
  </h2>
  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground">
    La queue au trait sur fond noir est le favicon retenu. Son contour crème reste distinct du logo
    et du renard du Hero. Les autres fonds et la tête sont conservés pour montrer les pistes
    explorées.
  </p>
  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    {options.map((option) => (
      <article class="rounded-lg border bg-card p-5 sm:p-6">
        <h3 class="text-xl font-medium">{option.label}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{option.description}</p>
        <div class="mt-5 grid grid-cols-3 gap-2 sm:gap-3">
          {backgrounds.map((bg) => (
            <div
              class="rounded-lg border p-2"
              style={{ background: bg.background, color: bg.foreground }}
            >
              <p class="text-center font-mono text-[10px]">{bg.label}</p>
              {option.id === 'tail' && bg.label === 'Noir' && (
                <p class="mt-1 text-center text-[9px]">Version utilisée</p>
              )}
              <Image
                src={option.id === 'tail' && bg.label === 'Noir' ? active : option.src}
                width={64}
                height={64}
                widths={[64, 128]}
                sizes="64px"
                format="png"
                alt={option.label + ', fond ' + bg.label.toLowerCase()}
                class="mx-auto my-4 h-16 w-16"
                style={bg.darkLine ? 'filter:brightness(0)' : undefined}
              />
              <div class="flex items-end justify-center gap-3">
                {[16, 32].map((size) => (
                  <div class="flex flex-col items-center gap-2">
                    <Image
                      src={option.id === 'tail' && bg.label === 'Noir' ? active : option.src}
                      width={size}
                      height={size}
                      widths={[size, size * 2]}
                      sizes={size + 'px'}
                      format="png"
                      alt=""
                      style={bg.darkLine ? 'filter:brightness(0)' : undefined}
                    />
                    <span class="font-mono text-[9px]">{size} px</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
