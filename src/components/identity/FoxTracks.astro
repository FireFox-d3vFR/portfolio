---
import { getImage } from 'astro:assets';
import tracks from '../../assets/images/fox-pawprints.png';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const mask = await getImage({ src: tracks, width: 540, format: 'webp', quality: 90 });
---

<span
  aria-hidden="true"
  class={'fox-tracks pointer-events-none select-none ' + className}
  style={{ '--fox-tracks-mask': `url("${mask.src}")` }}
></span>
