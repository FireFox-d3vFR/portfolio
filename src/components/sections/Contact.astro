---
import FoxTracks from '../identity/FoxTracks.astro';
import FoxLogo from '../identity/FoxLogo.astro';
import { contact, footer } from '../../data/site';
import Icon from '../ui/Icon.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import PolygonLeaf from '../decoration/PolygonLeaf.astro';
import MountainMotif from '../decoration/MountainMotif.astro';
const links = [
  ['LinkedIn', 'linkedin.com/in/jonathan-maquenhem', contact.linkedin],
  ['GitHub', 'github.com/FireFox-d3vFR', contact.github],
  ['Email', contact.email, 'mailto:' + contact.email],
];
---

<section id="contact" class="relative overflow-hidden bg-ink py-28 text-ink-foreground">
  <FoxTracks class="contact-tracks" />
  <MountainMotif class="pointer-events-none absolute inset-x-0 bottom-0 h-48 w-full text-ink-decoration/50" />
  <PolygonLeaf class="pointer-events-none absolute top-16 left-[8%] h-16 w-12 -rotate-12 text-primary/20" />
  <div class="relative mx-auto max-w-6xl px-5 text-center">
    <div class="reveal mx-auto max-w-4xl">
      <SectionLabel n="05" ink>
        Contact
      </SectionLabel>
      <h2 class="text-4xl leading-tight font-medium md:text-6xl">
        Et si nous construisions <em class="text-primary">quelque chose ensemble ?</em>
      </h2>
      <p class="mx-auto mt-6 max-w-lg text-ink-muted">
        Un projet, une opportunité ou simplement une question : je serai ravi d’échanger avec vous.
      </p>
      <button
        type="button"
        data-copy-email={contact.email}
        data-copy-feedback="copy-email-primary-status"
        class="mt-10 inline-flex cursor-pointer items-center gap-2 rounded-full bg-primary px-8 py-4 font-semibold text-primary-foreground transition-transform hover:scale-105"
      >
        Copier mon email <Icon name="arrow-right" />
      </button>
      <p
        id="copy-email-primary-status"
        role="status"
        class="mt-2 min-h-5 text-xs text-ink-muted"
      ></p>
    </div>
    <ul class="contact-links reveal mt-16">
      {links.map(([label, value, href]) => (
        <li class="min-w-0">
          <a
            href={href}
            target={href?.startsWith('http') ? '_blank' : undefined}
            rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="block h-full rounded-xl border border-ink-border p-5 text-left transition-colors hover:border-primary"
          >
            <p class="font-mono text-xs text-primary">{label}</p>
            <p class="contact-address mt-1 text-sm leading-relaxed text-ink-muted">{value}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<footer class="bg-ink text-ink-muted">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 border-t border-ink-border px-5 py-8 text-sm lg:flex-row">
    <div class="flex shrink-0 flex-col items-center gap-3 lg:items-start">
      <span class="flex items-center gap-2">
        <FoxLogo class="footer-fox-logo h-8 w-8 shrink-0 object-contain" />
        Jonathan Maquenhem
      </span>
      <nav
        aria-label="Pages secondaires"
        class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs lg:justify-start"
      >
        <a
          href="/identite/"
          class="rounded-sm underline-offset-4 transition-colors hover:text-ink-foreground hover:underline"
        >
          Identité visuelle
        </a>
        <a
          href="/informations/"
          class="rounded-sm underline-offset-4 transition-colors hover:text-ink-foreground hover:underline"
        >
          Informations du site
        </a>
      </nav>
    </div>
    <div class="footer-credits flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-center font-mono text-xs lg:justify-end">
      <span>
        © {new Date().getFullYear()} <span aria-hidden="true">·</span>{' '}
        <a
          href={contact.github}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-sm underline-offset-4 transition-colors hover:text-primary hover:underline"
          aria-label={'Profil GitHub de ' + footer.author + ' (nouvel onglet)'}
        >
          {footer.author}
        </a>
      </span>
      {footer.hosting && (
        <>
          <span aria-hidden="true">|</span>
          <a
            href={footer.hosting.href}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-sm underline-offset-4 transition-colors hover:text-primary hover:underline"
          >
            Hébergé sur {footer.hosting.label}
            <span class="sr-only"> (nouvel onglet)</span>
          </a>
        </>
      )}
      <span aria-hidden="true">|</span>
      <span>Fait avec soin, et un peu de malice.</span>
    </div>
  </div>
</footer>
