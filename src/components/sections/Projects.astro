---
import { PROJECTS } from '../../data/journey/entries';
import SectionLabel from '../ui/SectionLabel.astro';
import ProjectCover from '../projects/ProjectCover.astro';
import Icon from '../ui/Icon.astro';
import TechnologyBadge from '../ui/TechnologyBadge.astro';
---

<section id="projets" class="py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div>
        <SectionLabel n="03">Projets</SectionLabel>
        <h2 class="text-4xl font-medium md:text-5xl">
          Projets <em class="text-bark">et réalisations.</em>
        </h2>
      </div>
      <p class="max-w-sm text-muted-foreground">
        Applications métier, hackathons et projets associatifs ou indépendants.
      </p>
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-4">
      <p class="font-mono text-xs text-muted-foreground">{PROJECTS.length} projets à découvrir</p>
      <div
        data-project-view-controls
        hidden
        role="group"
        aria-label="Affichage des projets"
        class="inline-flex gap-1 rounded-full border bg-card p-1"
      >
        <button
          type="button"
          data-project-view="grid"
          aria-pressed="true"
          aria-controls="project-collection"
          class="project-view-choice inline-flex cursor-pointer items-center gap-2 rounded-full px-3.5 py-2 text-xs font-medium"
        >
          <svg
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
          </svg>
          Grille
        </button>
        <button
          type="button"
          data-project-view="list"
          aria-pressed="false"
          aria-controls="project-collection"
          class="project-view-choice inline-flex cursor-pointer items-center gap-2 rounded-full px-3.5 py-2 text-xs font-medium"
        >
          <svg
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M8 5h13M8 12h13M8 19h13M3 5h.01M3 12h.01M3 19h.01" />
          </svg>
          Liste
        </button>
      </div>
    </div>
    <div
      id="project-collection"
      data-view="grid"
      class="project-collection mt-6 grid gap-6 md:grid-cols-3"
    >
      {PROJECTS.map((entry) => (
        <article class="reveal card-lift project-card group flex flex-col overflow-hidden rounded-lg border bg-card">
          <div class="project-visual">
            <ProjectCover id={entry.logoId ?? entry.id} kind={entry.visual} />
          </div>
          <div class="project-body flex flex-1 flex-col p-6">
            <p class="project-meta font-mono text-xs text-muted-foreground">
              {entry.org !== entry.kind && <>{entry.shortOrg ?? entry.org} · </>}
              {entry.dates}
            </p>
            <h3 class="project-title mt-2 text-2xl font-medium">
              {entry.id === 'orange' ? 'Applications métier · Orange' : entry.title.split(': ')[0]}
            </h3>
            {entry.highlight && (
              <p class="project-highlight mt-2 text-xs font-semibold text-primary">
                {entry.highlight}
              </p>
            )}
            <p class="project-summary mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
              {entry.summary}
            </p>
            <ul class="project-technologies mt-5 flex flex-wrap gap-1.5">
              {entry.tech?.map((item) => (
                <TechnologyBadge name={item} compact />
              ))}
            </ul>
            <div class="project-footer mt-6 flex flex-wrap items-center justify-between gap-3 border-t pt-4">
              <span class="project-kind font-mono text-[10px] text-muted-foreground">
                {entry.kind}
              </span>
              <button
                type="button"
                data-entry={entry.id}
                aria-controls={'detail-' + entry.id}
                aria-haspopup="dialog"
                aria-label={'Découvrir le projet ' + entry.title}
                class="inline-flex h-8 shrink-0 cursor-pointer items-center gap-2 rounded-md px-2 text-xs text-bark transition-colors after:absolute after:inset-0 hover:bg-secondary"
              >
                <span class="project-action-label">Découvrir le projet</span>
                <Icon name="arrow" />
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p data-project-view-status class="sr-only" aria-live="polite"></p>
  </div>
</section>
