---
import SectionLabel from '../ui/SectionLabel.astro';
import PolygonLeaf from '../decoration/PolygonLeaf.astro';
import { qualities } from '../../data/about';
---

<section id="a-propos" class="relative py-24 sm:pt-12">
  <div class="mx-auto grid max-w-6xl gap-14 px-5 md:grid-cols-[0.9fr_1.1fr]">
    <div class="reveal">
      <SectionLabel n="01">À propos</SectionLabel>
      <h2 class="text-4xl leading-tight font-medium md:text-5xl">
        Du code solide, <em class="text-bark">pensé pour durer.</em>
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground max-sm:text-justify max-sm:hyphens-auto">
        Ce qui m’intéresse dans un projet, c’est de comprendre comment il fonctionne, à qui il sert
        et comment le faire évoluer. J’aime explorer les différentes facettes du développement,
        échanger avec les personnes concernées et construire des solutions que l’on pourra reprendre
        et améliorer dans le temps.
      </p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {qualities.map(([title, description], i) => (
        <div class="reveal card-lift trait-card relative overflow-hidden rounded-lg border bg-card p-6">
          <span class="font-mono text-xs text-primary">0{i + 1}</span>
          <PolygonLeaf
            class={
              'absolute top-5 right-5 h-8 w-6 text-accent ' + (i % 2 ? 'rotate-45' : '-rotate-12')
            }
          />
          <h3 class="mt-3 text-xl font-medium">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
