---
import {
  siAstro,
  siTypescript,
  siTailwindcss,
  siVercel,
  siPhp,
  siSymfony,
  siMariadb,
  siVuedotjs,
  siJavascript,
  siHtml5,
  siCss,
  siCloudfoundry,
  siGitlab,
  siDocker,
  siTerraform,
  siPrometheus,
  siGithubactions,
  siRailway,
  siWix,
  siWordpress,
  siGutenberg,
  siJoomla,
} from 'simple-icons';
interface Props {
  name: string;
}
const { name } = Astro.props;
const logos: Record<string, { path: string; hex: string }> = {
  Astro: siAstro,
  TypeScript: siTypescript,
  'Tailwind CSS': siTailwindcss,
  Vercel: siVercel,
  PHP: siPhp,
  Symfony: siSymfony,
  MariaDB: siMariadb,
  'Vue.js': siVuedotjs,
  JavaScript: siJavascript,
  HTML: siHtml5,
  CSS: siCss,
  'Cloud Foundry': siCloudfoundry,
  'GitLab CI/CD': siGitlab,
  Docker: siDocker,
  Terraform: siTerraform,
  Prometheus: siPrometheus,
};
Object.assign(logos, {
  'GitHub Actions': siGithubactions,
  Railway: siRailway,
  Wix: siWix,
  WordPress: siWordpress,
  Gutenberg: siGutenberg,
  Joomla: siJoomla,
});
const logo = logos[name];
const brandColor = logo
  ? '#' + logo.hex
  : name === 'API'
    ? '#7DD3FC'
    : name === 'DevOps & Cloud'
      ? 'var(--bark)'
      : '#80CBC4';
const brandSurface = name === 'Symfony' || name === 'MariaDB' ? '#FFFFFF' : 'transparent';
---

{(logo || name === 'API' || name === 'SQL' || name === 'DevOps & Cloud') && (
  <svg
    viewBox="0 0 24 24"
    class="technology-logo"
    style={{ '--brand-color': brandColor, '--brand-surface': brandSurface }}
    fill={logo ? 'currentColor' : 'none'}
    stroke={logo ? undefined : 'currentColor'}
    stroke-width={logo ? undefined : 1.5}
    aria-hidden="true"
    focusable="false"
  >
    {logo ? (
      <path d={logo.path} />
    ) : name === 'DevOps & Cloud' ? (
      <path
        d="M6 16c5 0 7-8 12-8a4 4 0 0 1 0 8c-5 0-7-8-12-8a4 4 0 1 0 0 8Z"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    ) : name === 'API' ? (
      <path
        d="m8 6-6 6 6 6m8-12 6 6-6 6m-3-14-2 16"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    ) : (
      <>
        <ellipse cx="12" cy="5" rx="8" ry="3" />
        <path d="M4 5v14c0 4 16 4 16 0V5M4 12c0 4 16 4 16 0" />
      </>
    )}
  </svg>
)}
