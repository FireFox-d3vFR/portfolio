---
import FoxLogo from "./FoxLogo.astro";
import Icon from "./Icon.astro";
import DisplayPreferences from "./DisplayPreferences.astro";
const links = [
  ["accueil", "Accueil"],
  ["a-propos", "À propos"],
  ["competences", "Compétences"],
  ["projets", "Projets"],
  ["parcours", "Parcours"],
  ["contact", "Contact"],
];
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-all">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5"
    aria-label="Navigation principale">
    <a
      href="#accueil"
      class="group flex shrink-0 items-center gap-2.5"
      aria-label="Accueil">
      <span
        class="relative grid h-9 w-9 place-items-center transition-transform group-hover:rotate-6">
        <FoxLogo />
      </span>
      <span class="font-display text-lg font-semibold"
        >jm<span class="text-primary">.</span></span
      >
    </a>
    <div class="flex items-center gap-2 lg:gap-4">
      <ul class="hidden gap-1 lg:flex">
        {
          links.map(([id, label]) => (
            <li>
              <a
                href={"#" + id}
                data-section-link={id}
                class="rounded-full px-3.5 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/assets/pdf/cv-jonathan-maquenhem.pdf"
        download
        class="nav-cv inline-flex shrink-0 items-center gap-2 rounded-full bg-ink px-4 py-2.5 text-xs font-semibold text-ink-foreground transition-colors hover:bg-primary hover:text-primary-foreground"
        aria-label="Télécharger mon CV au format PDF">
        Mon CV
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M12 3v12m-5-5 5 5 5-5M5 16v4h14v-4"></path></svg
        >
      </a>
      <DisplayPreferences />
      <button
        data-menu-toggle
        class="grid h-9 w-9 place-items-center rounded-md border border-input bg-background shadow-sm transition-colors hover:bg-accent lg:hidden"
        type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-navigation">
        <Icon name="menu" class="h-4 w-4" /><Icon
          name="close"
          class="hidden h-4 w-4"
        />
      </button>
    </div>
  </nav>
  <ul
    id="mobile-navigation"
    class="border-t bg-background px-5 py-3 lg:hidden"
    hidden>
    {
      links.map(([id, label]) => (
        <li>
          <a href={"#" + id}
                data-section-link={id} class="block py-2.5 font-medium">
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</header>
