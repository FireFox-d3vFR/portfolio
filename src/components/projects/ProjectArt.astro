---
import MountainMotif from '../decoration/MountainMotif.astro';
import PolygonLeaf from '../decoration/PolygonLeaf.astro';
interface Props {
  kind?: string;
}
const { kind = '' } = Astro.props;
---

{kind === 'portfolio' ? (
  <div
    class="portfolio-project-mark relative grid h-44 place-items-center overflow-hidden bg-secondary text-foreground"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 100 100"
      class="absolute right-4 bottom-0 h-32 w-32 text-primary/15"
      fill="currentColor"
    >
      <path d="M10 90 55 10 90 90Z" />
      <path d="m0 65 50-40 50 40Z" opacity=".5" />
    </svg>
    <span class="relative font-display text-6xl font-medium">
      jm<span class="text-primary">.</span>
    </span>
  </div>
) : kind === 'azor' ? (
  <div
    class="relative h-44 overflow-hidden bg-ink p-5 font-mono text-[11px] leading-6 text-ink-muted"
    aria-hidden="true"
  >
    <div class="mb-2 flex gap-1.5">
      <i class="h-2.5 w-2.5 rounded-full bg-primary"></i>
      <i class="h-2.5 w-2.5 rounded-full bg-accent"></i>
      <i class="h-2.5 w-2.5 rounded-full bg-sage"></i>
    </div>
    <p>
      <span class="text-primary">#[Route</span>('/api/…')]
    </p>
    <p>
      public function <span class="text-ink-foreground">index()</span>: Response
    </p>
    <p class="pl-4 text-ink-border">// application métier interne</p>
    <span class="absolute right-4 bottom-3 font-display text-5xl text-ink-border transition-colors group-hover:text-primary/40">
      AZOR
    </span>
  </div>
) : kind === 'watch' ? (
  <div class="relative grid h-44 place-items-center overflow-hidden bg-bark" aria-hidden="true">
    <MountainMotif class="absolute inset-x-0 bottom-0 h-28 w-full text-accent/20" />
    <div class="relative grid h-16 w-16 place-items-center rounded-full bg-primary text-primary-foreground transition-transform group-hover:scale-110">
      ▶
    </div>
    <div class="absolute inset-x-5 bottom-5 h-1 rounded-full bg-ink-border">
      <div class="h-full w-2/5 rounded-full bg-primary"></div>
    </div>
  </div>
) : kind === 'osteo' ? (
  <div class="relative grid h-44 place-items-center overflow-hidden bg-accent" aria-hidden="true">
    <PolygonLeaf class="absolute top-4 right-5 h-12 w-9 rotate-45 text-bark/25" />
    <svg
      viewBox="0 0 160 130"
      fill="none"
      class="h-32 w-40 text-primary transition-transform duration-500 group-hover:scale-110"
    >
      <rect x="15" y="15" width="130" height="100" rx="8" stroke="currentColor" stroke-width="3" />
      <path
        d="M15 36h130M27 26h2m8 0h2m8 0h2M36 50h33v45H36zM82 53h43M82 66h32M82 90h30"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
      />
    </svg>
  </div>
) : kind === 'enjo' ? (
  <div class="relative grid h-44 place-items-center overflow-hidden bg-accent" aria-hidden="true">
    <PolygonLeaf class="absolute top-4 right-5 h-12 w-9 rotate-45 text-bark/25" />
    <svg
      viewBox="0 0 160 150"
      fill="none"
      class="h-36 w-36 text-primary transition-transform duration-500 group-hover:scale-110"
    >
      <rect x="52" y="12" width="59" height="123" rx="10" stroke="currentColor" stroke-width="3" />
      <path
        d="M71 24h22M75 122h14m-25-49 18-16 18 16v26H64V73Zm12 26V83h12v16M25 65l-13 9 13 10m109-19 13 9-13 10"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
) : (
  <div class="relative grid h-44 place-items-center overflow-hidden bg-accent" aria-hidden="true">
    <PolygonLeaf class="absolute top-4 right-5 h-12 w-9 rotate-45 text-bark/25" />
    <div class="grid place-items-center transition-transform duration-500 group-hover:scale-110">
      {[0, 1, 2, 3].map((r) => (
        <span
          class="absolute rounded-full border-[6px]"
          style={{
            width: 130 - r * 30 + 'px',
            height: 130 - r * 30 + 'px',
            borderColor: r % 2 ? 'var(--background)' : 'var(--primary)',
          }}
        ></span>
      ))}
      <span class="relative h-3 w-3 rounded-full bg-ink"></span>
    </div>
  </div>
)}
