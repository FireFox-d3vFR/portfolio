---
import { ENTRIES } from '../data/entries';
import { CATEGORIES, getJourneyLayout } from '../lib/journey';
import SectionLabel from './SectionLabel.astro';
import PolygonLeaf from './PolygonLeaf.astro';
import Icon from './Icon.astro';
const {rows,count} = getJourneyLayout(ENTRIES);
---
<section id="parcours" class="relative border-t bg-secondary/40 py-24">
  <PolygonLeaf class="pointer-events-none absolute top-10 right-[8%] h-14 w-10 rotate-12 text-accent opacity-40 md:top-24 md:h-20 md:w-14" />
  <div class="relative mx-auto max-w-6xl gap-14 px-5 xl:grid xl:grid-cols-[0.65fr_1.35fr]">
    <div class="self-start xl:sticky xl:top-28">
      <div class="reveal"><SectionLabel n="04">Parcours</SectionLabel><div class="flex items-end justify-between gap-5"><h2 class="text-4xl font-medium md:text-5xl">Le chemin <em class="text-bark">jusqu’ici.</em></h2><Icon name="git" class="hidden h-10 w-10 shrink-0 text-bark/40 sm:block xl:hidden" /></div><p class="mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground">Mon parcours s’est construit entre études, travail en équipe et projets concrets. Chaque expérience m’a donné l’occasion d’apprendre et de mettre en pratique de nouvelles compétences.</p>
        <div class="mt-8 flex flex-wrap gap-x-5 gap-y-3" role="group" aria-label="Catégories du parcours">{CATEGORIES.map(({key,label,icon}) => <button type="button" data-category={key} aria-pressed="true" aria-controls="journey-graph" class={'journey-filter is-active inline-flex cursor-pointer items-center gap-2 text-sm cat-'+key}><Icon name={icon} /><span>{label}</span><span class="filter-dot" aria-hidden="true"></span></button>)}</div>
      </div>
      <div class="journey-key" aria-label="Légende des nœuds du parcours"><span><i class="key-point" aria-hidden="true"></i>Événement</span><span><i aria-hidden="true"></i>Période</span><span><i class="key-ongoing" aria-hidden="true"></i>En cours</span></div>
      <p class="journey-reading">Du plus récent au plus ancien. Utilisez les filtres pour afficher les catégories qui vous intéressent, puis ouvrez une carte pour en savoir plus. Les lignes parallèles repèrent les activités menées en même temps ; les espacements ne représentent pas leur durée.</p>
    </div>
    <div class="mt-12 min-w-0 xl:mt-0">
      <ol id="journey-graph" class="git-graph" style={'--lanes:'+Math.max(count,1)}>
        <li data-journey-now class="git-now font-mono text-[10px] uppercase tracking-[0.14em] text-muted-foreground" aria-hidden="true">Aujourd’hui</li>
        {rows.map(({entry,lane,year,upward,lines}) => <li class="git-row" data-journey-id={entry.id} data-category={entry.category} data-start={entry.start} data-end={entry.end ?? ''}>
          <span class="git-year font-mono text-[11px] text-muted-foreground">{year}</span>
          <div class="git-lanes" aria-hidden="true">
            {lines.map(line => <span class={'git-line cat-'+line.category+(line.capped?' is-capped':'')} style={'--lane:'+line.lane+';--cap-progress:'+line.capProgress}></span>)}
            {upward && <span class={'git-line git-line-up cat-'+entry.category} style={'--lane:'+lane}></span>}
            <span class={'git-node cat-'+entry.category+(entry.end===entry.start?' is-point':'')+(!entry.end?' is-ongoing':'')} style={'--lane:'+lane}></span>
          </div>
          <button type="button" data-entry={entry.id} aria-controls={'detail-'+entry.id} aria-haspopup="dialog" class={'git-card cat-'+entry.category} aria-label={'Voir le détail : '+entry.title}>
            <span class="flex flex-wrap items-center gap-x-2 font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground"><span class="git-card-cat">{CATEGORIES.find(item => item.key===entry.category)?.label}</span>· {entry.dates}</span>
            <h3 class="mt-1.5 text-lg leading-snug font-medium sm:text-xl">{entry.title}</h3>{entry.org !== entry.kind && <span class="mt-0.5 block text-sm font-semibold text-bark">{entry.shortOrg ?? entry.org}{entry.kind!=='Formation'&&!entry.org.toLocaleLowerCase('fr').includes(entry.kind.toLocaleLowerCase('fr'))?' · '+entry.kind:''}</span>}
            {entry.highlight && <span class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-primary"><Icon name="trophy" class="h-3.5 w-3.5" />{entry.highlight}</span>}
            {entry.summary && <span class="mt-2 hidden text-sm leading-relaxed text-muted-foreground sm:line-clamp-2">{entry.summary}</span>}
            <span class="journey-entry-footer">
              <span class:list={['journey-entry-status', !entry.end ? 'is-ongoing' : entry.end === entry.start ? 'is-point' : '']}>{!entry.end ? 'En cours' : entry.end === entry.start ? 'Événement ponctuel' : 'Période'}</span>
              <span class="journey-entry-action inline-flex items-center gap-1" aria-hidden="true">Détails <Icon name="arrow" class="h-3 w-3" /></span>
            </span>
          </button>
        </li>)}
      </ol>
      <p data-journey-empty hidden class="py-16 text-sm text-muted-foreground">Aucune catégorie sélectionnée.</p>
      <p data-journey-status class="sr-only" aria-live="polite"></p>
    </div>
  </div>
</section>
